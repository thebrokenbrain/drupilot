{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebrokenbrain.github.io/drupilot/schemas/pipeline.schema.json",
  "title": "drupilot stage catalog (config/pipeline.json)",
  "description": "The ordered stage list of AR-07, shared by the pipeline runner, the progress model and the docs. Stage ids are public and stable from drupilot 1.0 on.",
  "type": "object",
  "required": ["schema", "conditions", "stages"],
  "additionalProperties": false,
  "properties": {
    "_comment": {"type": "string"},
    "schema": {"const": 1},
    "conditions": {
      "description": "The closed set of conditions a stage's when may name, each with its meaning.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9-]+(:[a-z0-9-]+)?$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "weight", "when", "tabs", "subs", "outputs", "gate", "coarse_stage", "procedure_anchor"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "kind": {"enum": ["det", "det+tab", "det+ai", "ai", "outward"]},
          "weight": {"type": "integer", "minimum": 1},
          "when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "skip_reason": {
            "description": "The reason recorded when the named when condition is false (the stage is then skipped, not absent).",
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          },
          "tabs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
          "subs": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
          "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "gate": {"type": "string", "minLength": 1},
          "coarse_stage": {"enum": ["setup", "assessed", "ported", "refactored", "tested", "contributed", null]},
          "procedure_anchor": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["skill", "heading"],
                "additionalProperties": false,
                "properties": {
                  "skill": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                  "heading": {"type": "string", "minLength": 1}
                }
              }
            ]
          }
        }
      }
    }
  }
}
