{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebrokenbrain.github.io/drupilot/schemas/upgrade-plan.schema.json",
  "title": "drupilot upgrade plan (scripts/analysis/upgrade-path.sh --json; .upgrade_plan in the lock)",
  "description": "Every version a stage uses, resolved once from the subject, the target major T, the PHP target P, the strategy and the version data (AR-06, ADR 0017). Every key is always present: null means not computed yet (a later milestone fills it), [] means computed and empty. meta is excluded from .upgrade_plan_hash. The nodes marked x-drupilot-hard-gate are what the hard gates read: the target major and bed core, the PHP floor and final, the declared range, the hops and the toolchain cell.",
  "type": "object",
  "required": ["schema_version", "meta", "subject", "source", "target", "range", "php", "hops", "rector", "phpstan", "toolchain_cell", "test_matrix", "detectors", "core_removals", "hard_breaks", "ci_flags", "patch_name", "workspace_suffix", "data_hash", "automation_estimate"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "meta": {
      "description": "What changes between two runs that resolve the same plan; never hashed.",
      "type": "object",
      "required": ["generated_at", "drupilot_version", "phase"],
      "additionalProperties": false,
      "properties": {
        "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "drupilot_version": {"type": "string", "minLength": 1},
        "phase": {"$ref": "#/$defs/phase"}
      }
    },
    "subject": {
      "type": "object",
      "required": ["machine_name", "type"],
      "additionalProperties": false,
      "properties": {
        "machine_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"type": "string", "pattern": "^[a-z_]+$"}
      }
    },
    "source": {
      "description": "The source era S and track from scripts/analysis/detect-source.sh (ADR 0016); evidence_hash is the hash of its canonical JSON.",
      "type": "object",
      "required": ["major", "track", "evidence_hash"],
      "additionalProperties": false,
      "properties": {
        "major": {"type": "integer", "minimum": 7},
        "track": {"enum": ["standard", "d7-assisted"]},
        "evidence_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "required": ["major", "status", "preview", "bed_core", "ddev_type"],
      "additionalProperties": false,
      "properties": {
        "major": {"x-drupilot-hard-gate": true, "type": "integer", "minimum": 8},
        "status": {"enum": ["supported", "pre-release", "eol"]},
        "preview": {"description": "true when T is a pre-release ported to as a preview (DRUPILOT_ALLOW_PRERELEASE).", "type": "boolean"},
        "bed_core": {"x-drupilot-hard-gate": true, "description": "The exact core the test-bed runs: the lock's core when it is a T version, else the data's latest release of M.", "$ref": "#/$defs/core_version"},
        "ddev_type": {"type": ["string", "null"], "pattern": "^drupal[0-9]+$"}
      }
    },
    "range": {
      "description": "The declared core range C (core_version_requirement) and its floor F. strategy is what was asked (the 1.0 names; the 0.9 names d11-only and keep-d10 are input aliases), resolved_strategy what it resolved to (keep-current keeps a declaration that already admits T).",
      "type": "object",
      "required": ["strategy", "resolved_strategy", "constraint", "floor", "spans_majors"],
      "additionalProperties": false,
      "properties": {
        "strategy": {"enum": ["auto", "keep-previous", "target-only", "widest", "explicit"]},
        "resolved_strategy": {"enum": ["keep-current", "keep-previous", "target-only", "explicit"]},
        "constraint": {"x-drupilot-hard-gate": true, "type": "string", "minLength": 1},
        "floor": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+$"},
        "spans_majors": {"type": "boolean"}
      }
    },
    "php": {
      "description": "The PHP window W = [floor L .. final P].",
      "type": "object",
      "required": ["floor", "final", "window", "require_php", "phpstan_phpversion", "phpcompat_testversion"],
      "additionalProperties": false,
      "properties": {
        "floor": {"x-drupilot-hard-gate": true, "$ref": "#/$defs/php_minor"},
        "final": {"x-drupilot-hard-gate": true, "$ref": "#/$defs/php_minor"},
        "window": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/php_minor"}},
        "require_php": {"description": "composer.json require.php: \">=L\" when the range keeps a previous major, else null (core enforces its own minimum).", "type": ["string", "null"], "pattern": "^>=[0-9]+\\.[0-9]+$"},
        "phpstan_phpversion": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {"min": {"type": "integer", "minimum": 70000}, "max": {"type": "integer", "minimum": 70000}}
        },
        "phpcompat_testversion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+-[0-9]+\\.[0-9]+$"}
      }
    },
    "hops": {"x-drupilot-hard-gate": true, "description": "The paths/graph.json edges from S to T; [] when S = T.", "type": "array", "items": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"}},
    "rector": {
      "type": "object",
      "required": ["drupal_sets", "breaking_sets", "sets_skipped", "bc", "php_level", "skip", "compat_rules", "polyfills", "tests_pass"],
      "additionalProperties": false,
      "properties": {
        "drupal_sets": {"type": "array", "items": {"$ref": "#/$defs/rector_set"}},
        "breaking_sets": {"type": "array", "items": {"$ref": "#/$defs/rector_set"}},
        "sets_skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hop", "family", "set", "reason"],
            "additionalProperties": false,
            "properties": {
              "hop": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
              "family": {"type": "string", "pattern": "^Drupal[0-9]+SetList$"},
              "set": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/rector_set"}]},
              "reason": {"enum": ["no-fallback-data", "missing-family", "missing-constant"]}
            }
          }
        },
        "bc": {
          "type": "object",
          "required": ["enabled", "min_core"],
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "min_core": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+$"}
          }
        },
        "php_level": {"type": "string", "pattern": "^PHP_[0-9]+$"},
        "skip": {"type": "array", "items": {"type": "string", "pattern": "^Rector\\\\"}},
        "compat_rules": {"type": ["array", "null"], "items": {"type": "string"}},
        "polyfills": {"type": ["array", "null"], "items": {"type": "string"}},
        "tests_pass": {"type": ["object", "null"]}
      }
    },
    "phpstan": {
      "type": "object",
      "required": ["profile", "level"],
      "additionalProperties": false,
      "properties": {
        "profile": {"enum": ["compat"]},
        "level": {"type": ["integer", "string"], "pattern": "^(max|[0-9]+)$"}
      }
    },
    "toolchain_cell": {"x-drupilot-hard-gate": true, "description": "The toolchain matrix cell (config/toolchain-reference.json) T installs.", "type": "string", "minLength": 1},
    "test_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["leg", "core", "php", "mode"],
        "additionalProperties": false,
        "properties": {
          "leg": {"enum": ["CURRENT", "PHP_LOW", "PREVIOUS_MAJOR"]},
          "core": {"anyOf": [{"$ref": "#/$defs/core_version"}, {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}]},
          "php": {"anyOf": [{"$ref": "#/$defs/php_minor"}, {"type": "null"}]},
          "mode": {"enum": ["run", "static"]}
        }
      }
    },
    "detectors": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "core_removals": {"type": ["array", "null"]},
    "hard_breaks": {"type": ["array", "null"]},
    "ci_flags": {
      "type": "object",
      "required": ["OPT_IN_TEST_PREVIOUS_MAJOR", "OPT_IN_TEST_MAX_PHP"],
      "additionalProperties": false,
      "properties": {
        "OPT_IN_TEST_PREVIOUS_MAJOR": {"enum": [0, 1]},
        "OPT_IN_TEST_MAX_PHP": {"enum": [0, 1]}
      }
    },
    "patch_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*-port-to-drupal-[0-9]+\\.patch$"},
    "workspace_suffix": {"type": "string", "pattern": "^-d[0-9]+$"},
    "data_hash": {"$ref": "#/$defs/sha256"},
    "automation_estimate": {"type": ["object", "null"]}
  },
  "$defs": {
    "phase": {"enum": ["draft", "final"]},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "php_minor": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "core_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?$"},
    "rector_set": {"type": "string", "pattern": "^Drupal[0-9]+SetList::DRUPAL_[0-9]+(_BREAKING)?$"}
  }
}
