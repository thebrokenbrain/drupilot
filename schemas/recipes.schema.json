{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thebrokenbrain.github.io/drupilot/schemas/recipes.schema.json",
  "title": "drupilot recipe catalog (config/recipes.json)",
  "description": "The recipes of AR-11 (drupilot.recipes/1, ADR 0023), generated by scripts/dev/gen-recipes.sh from the catalogs named in sources. The classifier maps a finding to a recipe and its lane; apply-recipe.sh runs the codemods.",
  "type": "object",
  "required": ["schema", "_comment", "sources", "recipes"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "drupilot.recipes/1"},
    "_comment": {"type": "string"},
    "sources": {
      "description": "Each catalog the recipes were generated from, with its file_hash.",
      "type": "object",
      "propertyNames": {"pattern": "^config/[a-z-]+\\.json$"},
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "recipes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recipe"}}
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "required": ["id", "version", "lane", "kind", "engine", "matches", "applies_when", "template", "postconditions", "source", "fixtures"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(dep|sig|safety|meta|life)\\.[a-z0-9]+(-[a-z0-9]+)*$"},
        "version": {"description": "The first 12 hex of the sha256 of the recipe without version, source and fixtures.", "type": "string", "pattern": "^[0-9a-f]{12}$"},
        "lane": {"enum": ["rector", "rector-custom", "codemod", "ai-templated", "ai-free", "test-adapt", "human", "deferred"]},
        "kind": {"enum": ["template", "codemod"]},
        "engine": {"enum": ["template", "ere-replace", "yaml-edit", "info-yml", "attributes", "php-script", "rector-rule"]},
        "matches": {
          "type": "object",
          "anyOf": [{"required": ["rule"]}, {"required": ["message_ere"]}, {"required": ["symbols"]}],
          "additionalProperties": false,
          "properties": {
            "rule": {"type": "string", "pattern": "^(signature|port-safety|metadata):[a-z0-9-]+$"},
            "message_ere": {"type": "string", "minLength": 1},
            "symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "applies_when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "core_min": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
            "file_ere": {"type": "string", "minLength": 1},
            "severity": {"type": "array", "minItems": 1, "items": {"enum": ["error", "warning", "info"]}}
          }
        },
        "params": {"type": "object"},
        "template": {
          "type": "object",
          "required": ["why"],
          "additionalProperties": false,
          "properties": {
            "why": {"type": "string", "minLength": 1},
            "fix": {"type": "string", "minLength": 1},
            "d10_compat": {"type": "string"},
            "since": {"type": "string"},
            "category": {"type": "string"},
            "change_record_search_url": {"type": "string", "pattern": "^https://www\\.drupal\\.org/"},
            "lifecycle": {"type": "array", "items": {"type": "object", "required": ["symbol"]}}
          }
        },
        "postconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["absent-ere", "absent-fixed", "present-fixed", "rescan"]},
              "where": {"enum": ["line", "file", "file-except-line"]},
              "ere": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "source": {"type": "string", "pattern": "^config/[a-z-]+\\.json#/"},
        "fixtures": {"anyOf": [{"type": "string", "pattern": "^tests/fixtures/recipes/"}, {"type": "null"}]}
      }
    }
  }
}
