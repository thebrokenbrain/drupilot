    {
      "id": "p80-sort-bool-comparator",
      "rule": null,
      "detect": "scan:sort-bool-comparator",
      "kind": "report-only",
      "deprecated_in": "8.0",
      "removed_in": null,
      "output_min_php": null,
      "drupal_safe": null,
      "src": "https://www.php.net/manual/en/migration80.deprecated.php",
      "verified": true,
