      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.5.2/rules/Php82/Rector/Class_/ReadOnlyClassRector.php",
      "verified": true,
      "reason": "Makes every property readonly, with the same DependencySerializationTrait::__wakeup() breakage as ReadOnlyPropertyRector. templates/rector.php.tmpl skips it (S4)."
    },
    {
      "id": "deny-constructor-promotion",
      "rule": "Rector\\Php80\\Rector\\Class_\\ClassPropertyAssignToConstructorPromotionRector",
      "kind": "deny",
      "deprecated_in": null,
      "removed_in": null,
      "output_min_php": "8.0",
      "drupal_safe": false,
      "src": "https://www.php.net/manual/en/language.oop5.decon.php#language.oop5.decon.constructor.promotion",
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.6.1/rules/Php80/Rector/Class_/ClassPropertyAssignToConstructorPromotionRector.php",
      "verified": true,
      "reason": "A style rewrite, never a compatibility fix, in the php80 level set the floor's sets include. Rector 2.6.1 promotes a parameter the constructor body later changes and rewrites those changes to the property (training run 01, filelog LogMessage: $this->placeholders lost its @/%/: prefixes, so messages were no longer substituted), and it moves each property's doc block into the parameter list, which phpcbf cannot fix. templates/rector.php.tmpl skips it (S4)."
    },
    {
      "id": "p81-null-to-internal",
      "rule": "Rector\\Php81\\Rector\\FuncCall\\NullToStrictStringFuncCallArgRector",
      "kind": "deny",
      "deprecated_in": "8.1",
      "removed_in": null,
      "output_min_php": null,
      "drupal_safe": false,
      "reason": "templates/rector.php.tmpl skips it (S4): it adds (string) casts that change semantics and fail stricter project PHPStan levels. The deprecation is reported, never fixed by this rule.",
      "src": "https://www.php.net/manual/en/migration81.deprecated.php",
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.5.2/rules/Php81/Rector/FuncCall/NullToStrictStringFuncCallArgRector.php",
      "verified": true,
      "construct": "null passed to a non-nullable parameter of a built-in function"
    },
    {
      "id": "deny-sleep-to-serialize",
      "rule": "Rector\\Php85\\Rector\\Class_\\SleepToSerializeRector",
      "kind": "deny",
      "deprecated_in": "8.5",
      "removed_in": null,
      "output_min_php": "7.4",
      "drupal_safe": false,
      "src": "https://www.php.net/manual/en/migration85.deprecated.php",
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.5.2/rules/Php85/Rector/Class_/SleepToSerializeRector.php",
      "verified": true,
      "reason": "DependencySerializationTrait implements __sleep()/__wakeup(): the rewrite breaks the service re-injection drupilot code relies on (03-F-D7). PHP 8.5 only soft-deprecates them (no E_DEPRECATED)."
    },
    {
