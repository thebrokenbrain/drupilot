    {
      "id": "deny-array-first-class-callable",
      "rule": "Rector\\Php81\\Rector\\Array_\\ArrayToFirstClassCallableRector",
      "kind": "deny",
      "deprecated_in": null,
      "removed_in": null,
      "output_min_php": "8.1",
      "drupal_safe": false,
      "src": "https://www.php.net/manual/en/functions.first_class_callable_syntax.php",
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.5.2/rules/Php81/Rector/Array_/ArrayToFirstClassCallableRector.php",
      "verified": true,
      "reason": "Turns Form/Render API callbacks such as '#submit' => [[$this, 'submitX']] into $this->submitX(...): a closure is not serializable, so a cached form (#ajax, form state cache) fatals. templates/rector.php.tmpl skips it (S4); check-port-safety.sh flags such a closure."
    },
    {
      "id": "deny-override-on-methods",
      "rule": "Rector\\Php83\\Rector\\ClassMethod\\AddOverrideAttributeToOverriddenMethodsRector",
      "kind": "deny",
      "deprecated_in": null,
      "removed_in": null,
      "output_min_php": "8.3",
      "drupal_safe": false,
      "src": "https://www.php.net/manual/en/class.override.php",
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.5.2/rules/Php83/Rector/ClassMethod/AddOverrideAttributeToOverriddenMethodsRector.php",
      "verified": true,
      "reason": "Adds #[\\Override] by looking at the test-bed core only: a method that exists in the parent only on newer cores then fatals on PHP 8.3+ with every older core the module declares. templates/rector.php.tmpl skips it (S4); check-port-safety.sh flags #[\\Override] while the range spans Drupal 10."
    },
    {
      "id": "deny-readonly-property",
      "rule": "Rector\\Php81\\Rector\\Property\\ReadOnlyPropertyRector",
      "kind": "deny",
      "deprecated_in": null,
      "removed_in": null,
      "output_min_php": "8.1",
      "drupal_safe": false,
      "src": "https://www.php.net/manual/en/language.oop5.properties.php#language.oop5.properties.readonly-properties",
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.5.2/rules/Php81/Rector/Property/ReadOnlyPropertyRector.php",
      "verified": true,
      "reason": "A readonly property cannot be re-initialized by DependencySerializationTrait::__wakeup() (forms, plugins, controllers that get serialized). templates/rector.php.tmpl skips it (S4)."
    },
    {
      "id": "deny-readonly-class",
      "rule": "Rector\\Php82\\Rector\\Class_\\ReadOnlyClassRector",
      "kind": "deny",
      "deprecated_in": null,
