    {
      "id": "p85-ord-single-byte",
      "rule": "Rector\\Php85\\Rector\\FuncCall\\OrdSingleByteRector",
      "kind": "compat",
      "deprecated_in": "8.5",
      "removed_in": null,
      "output_min_php": null,
      "drupal_safe": false,
      "src": "https://www.php.net/manual/en/migration85.deprecated.php",
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.6.1/rules/Php85/Rector/FuncCall/OrdSingleByteRector.php",
      "verified": true,
      "construct": "ord() of a string that is not a single byte",
      "reason": "Rewrites ord($s) to ord($s[0]) for any string-typed argument: on an empty string $s[0] raises an 'Uninitialized string offset' warning on every PHP, where ord('') returned 0 silently before PHP 8.5 (observed on PHP 8.2, 8.4 and 8.5 in the lab, ADR 0030). Reported, not applied."
    },
