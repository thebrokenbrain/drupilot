      "verified": true,
      "reason": "See deny-sleep-to-serialize."
    },
    {
      "id": "deny-override-on-properties",
      "rule": "Rector\\Php85\\Rector\\Property\\AddOverrideAttributeToOverriddenPropertiesRector",
      "kind": "deny",
      "deprecated_in": null,
      "removed_in": null,
      "output_min_php": "8.5",
      "drupal_safe": false,
      "src": "https://github.com/rectorphp/rector-src/blob/2.5.2/config/set/php85.php (in the php85 level set)",
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.5.2/rules/Php85/Rector/Property/AddOverrideAttributeToOverriddenPropertiesRector.php",
      "verified": true,
      "reason": "Adds #[\\Override] to properties, valid only on PHP 8.5; it collides with the override-attribute port-safety check while the core range spans an older PHP."
    },
    {
      "id": "deny-deprecated-attribute",
      "rule": "Rector\\Php84\\Rector\\Class_\\DeprecatedAnnotationToDeprecatedAttributeRector",
      "kind": "deny",
      "deprecated_in": null,
      "removed_in": null,
      "output_min_php": "8.4",
      "drupal_safe": false,
      "src": "https://www.php.net/manual/en/class.deprecated.php",
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.6.1/rules/Php84/Rector/Class_/DeprecatedAnnotationToDeprecatedAttributeRector.php",
      "verified": true,
      "reason": "Turns an @deprecated docblock on a function, a method or a class constant into #[\\Deprecated]: from PHP 8.4 every use of it then emits a native E_USER_DEPRECATED (php.net), next to the @trigger_error() Drupal's deprecation policy already calls, and Drupal core uses no #[\\Deprecated] (11.4.8: none). It is in the php84 level set and in PHP_POLYFILLS (polyfill-php84), which the plan's polyfills open from ^11.2 (ADR 0030)."
    },
