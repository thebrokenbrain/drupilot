    {
      "id": "p83-get-class-no-args",
      "rule": "Rector\\Php83\\Rector\\FuncCall\\RemoveGetClassGetParentClassNoArgsRector",
      "kind": "compat",
      "deprecated_in": "8.3",
      "removed_in": null,
      "output_min_php": null,
      "drupal_safe": false,
      "src": "https://www.php.net/manual/en/migration83.deprecated.php",
      "phpcompat": [
        "PHPCompatibility.ParameterValues.RemovedGetClassNoArgs.ArgMissing"
      ],
      "rule_src": "https://github.com/rectorphp/rector-src/tree/2.6.1/rules/Php83/Rector/FuncCall/RemoveGetClassGetParentClassNoArgsRector.php",
      "verified": true,
      "construct": "get_class()/get_parent_class() without arguments",
      "reason": "Rewrites get_parent_class() with no argument to parent::class without checking that a parent exists: in a class with no parent that is a compile-time fatal (\"Cannot use \\\"parent\\\" when current class scope has no parent\", PHP 8.4 in the lab), where the call returned false; in a trait it fails at run time. Its get_class() -> self::class half is safe, but the rule is one: reported, not applied (ADR 0030)."
    },
