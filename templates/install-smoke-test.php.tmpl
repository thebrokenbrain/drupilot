<?php

/**
 * @file
 * Drupilot install smoke test for {{MACHINE_NAME}}.
 *
 * GENERATED by scripts/tests/install-smoke.sh into
 * <drupal_root>/.drupilot/smoke/<machine_name>/ (gitignored) for a subject
 * that ships no PHPUnit test. It is drupilot's check, never copied into the
 * subject and never presented as a test of the module: it proves only that
 * the subject installs on the test-bed's core (with core's strict config
 * schema check), serves the front page and uninstalls. Do not edit: the next
 * run overwrites it.
 */

declare(strict_types=1);

namespace Drupal\Tests\drupilot_smoke\Functional;

use Drupal\Tests\BrowserTestBase;
use PHPUnit\Framework\Attributes\Group;
use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;

/**
 * Installs {{MACHINE_NAME}} ({{SUBJECT_TYPE}}), opens pages, uninstalls it.
 *
 * The attributes are what core 11.3+ asks of a Functional test (PHPUnit 9 on
 * Drupal 10 ignores them and reads the annotation).
 *
 * @group drupilot_smoke
 */
#[Group('drupilot_smoke')]
#[RunTestsInSeparateProcesses]
class DrupilotInstallSmokeTest extends BrowserTestBase {

  /**
   * {@inheritdoc}
   */
  protected $defaultTheme = 'stark';

  /**
   * Installs the subject, opens the front page, uninstalls it.
   */
  public function testInstallSmoke(): void {
    $name = '{{MACHINE_NAME}}';
    $is_theme = '{{SUBJECT_TYPE}}' === 'theme';
    if ($is_theme) {
      $this->container->get('theme_installer')->install([$name]);
      $this->config('system.theme')->set('default', $name)->save();
    }
    else {
      $this->container->get('module_installer')->install([$name]);
    }
    $this->rebuildContainer();

    $this->drupalGet('<front>');
    $this->assertSession()->statusCodeEquals(200);
    $this->drupalLogin($this->drupalCreateUser([], NULL, TRUE));
    $this->drupalGet('<front>');
    $this->assertSession()->statusCodeEquals(200);
    $this->drupalGet('admin/config');
    $this->assertSession()->statusCodeEquals(200);

    if ($is_theme) {
      $this->config('system.theme')->set('default', 'stark')->save();
      $this->container->get('theme_installer')->uninstall([$name]);
    }
    else {
      $this->container->get('module_installer')->uninstall([$name]);
    }
    $this->rebuildContainer();
    $this->drupalGet('<front>');
    $this->assertSession()->statusCodeEquals(200);
  }

}
